amp":1777911825745,"user_tz":300,"elapsed":1216,"user":{"displayName":"Doctorado Ucuenca","userId":"10085683705662726092"}},"outputId":"41ca39b1-fc53-4d94-a9be-9c77f5bed19c"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x1200 with 7 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":[],"metadata":{"id":"t8cD7eWpR9bn"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def kge(sim, obs):\n","    sim = np.array(sim)\n","    obs = np.array(obs)\n","\n","    # Remove NaNs if necessary\n","    mask = ~np.isnan(sim) & ~np.isnan(obs)\n","    sim = sim[mask]\n","    obs = obs[mask]\n","\n","    r = np.corrcoef(sim, obs)[0, 1]  # Correlation coefficient\n","    alpha = np.std(sim) / np.std(obs)  # Variability ratio\n","    beta = np.mean(sim) / np.mean(obs)  # Bias ratio\n","\n","    kge_value = 1 - np.sqrt((r - 1)**2 + (alpha - 1)**2 + (beta - 1)**2)\n","\n","    return kge_value, r, alpha, beta\n"],"metadata":{"id":"p2Zh1t2UUXy7"},"execution_count":null,"outputs":[]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":206},"id":"b8c56ec5","executionInfo":{"status":"ok","timestamp":1777911825759,"user_tz":300,"elapsed":3,"user":{"displayName":"Doctorado Ucuenca","userId":"10085683705662726092"}},"outputId":"8fd29401-cf3f-485b-e653-da75ff69ee57"},"source":["\n","# The 'kge' function should be defined in a previous cell (p2Zh1t2UUXy7).\n","# The variables pred_cats, true_cats, avg_pred_monthly, and true_monthly\n","# are assumed to be available in the kernel state.\n","\n","results = []\n","for i in range(4):\n","  kge_val, r_val, alpha_val, beta_val = kge(predicted_monthly[str(i)], true_monthly[str(i)])\n","  results.append({\n","      'Category': f'Category {i}',\n","      'KGE': kge_val,\n","      'r': r_val,\n","      'alpha': alpha_val,\n","      'beta': beta_val\n","  })\n","\n","# Overall monthly KGE using average predicted monthly rainfal